---
import { credentials } from '../lib/content';

const { certifications, recognition, education } = credentials;
---

<section id="credentials" class="section">
  <div class="wrap">
    <p class="kicker">// credentials</p>
    <h2>Recognition and learning</h2>
    <div class="cols">
      <div class="card col">
        <h3>Community</h3>
        <ul>
          {
            recognition.map((r) => (
              <li>
                <strong>{r.name}</strong>
                <span>
                  {r.issuer}
                  {r.since && ` · since ${r.since}`}
                </span>
              </li>
            ))
          }
        </ul>
      </div>
      <div class="card col">
        <h3>Certifications</h3>
        <ul>
          {
            certifications.map((c) => (
              <li>
                <strong>{c.name}</strong>
                <span>
                  {c.issuer}
                  {c.expired && <em class="expired">expired</em>}
                </span>
              </li>
            ))
          }
        </ul>
      </div>
      <div class="card col">
        <h3>Education</h3>
        <ul>
          {
            education.map((e) => (
              <li>
                <strong>{e.degree}</strong>
                <span>
                  {e.school} · {e.start}–{e.end}
                </span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .cols {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
    gap: 16px;
  }
  .col {
    padding: 22px;
  }
  h3 {
    font-family: var(--mono);
    font-size: 0.78rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--muted);
    margin-bottom: 14px;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 14px;
  }
  strong {
    display: block;
    font-weight: 620;
  }
  li span {
    color: var(--text-2);
    font-size: 0.9rem;
  }
  .expired {
    font-style: normal;
    font-family: var(--mono);
    font-size: 0.72rem;
    color: var(--muted);
    border: 1px solid var(--border-strong);
    border-radius: 6px;
    padding: 0 6px;
    margin-left: 8px;
  }
</style>
