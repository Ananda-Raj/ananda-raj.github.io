---
import Icon from './Icon.astro';
import { profile, phoneDisplay, apiUrl, firstName } from '../lib/content';

const suggestions = [
  `What does ${firstName} work on?`,
  `Has ${firstName} run Kubernetes in production?`,
  'Our AWS bill keeps growing. Where do we start?',
  `Which articles has ${firstName} written?`,
];
---

<section id="contact" class="section">
  <div class="wrap">
    <div class="panel">
      <p class="kicker">// contact</p>
      <h2>{profile.contact.heading}</h2>
      <p class="text">{profile.contact.text}</p>

      {
        apiUrl && (
          <div class="duo" data-api={apiUrl} data-name={firstName}>
            <div class="card chat">
              <div class="chat-head">
                <span class="title">
                  <Icon name="spark" /> Ask my AI
                </span>
                <span class="note">answers from this site</span>
              </div>
              <div class="log" data-log aria-live="polite">
                <div class="msg bot">
                  Hi! Ask about {firstName}'s work, or describe what you're stuck on in AWS, Kubernetes, Terraform or GenAI.
                </div>
              </div>
              <div class="suggest" data-suggest>
                {suggestions.map((s) => (
                  <button type="button">{s}</button>
                ))}
              </div>
              <form class="ask" data-ask>
                <textarea rows="1" maxlength="1000" placeholder="Type your question…" aria-label="Your question" required />
                <button class="btn btn-primary btn-sm" type="submit">
                  Send
                </button>
              </form>
              <p class="fine">
                AI answers can be wrong. Questions are kept for 30 days to improve answers, so please don't share personal details.
                <a href="#contact-form" data-handoff hidden>
                  Continue with {firstName} →
                </a>
              </p>
            </div>

            <form class="card form" id="contact-form" data-contact novalidate>
              <h3>Send a message</h3>
              <label>
                Name
                <input name="name" required maxlength="100" autocomplete="name" />
              </label>
              <label>
                Email
                <input name="email" type="email" required maxlength="200" autocomplete="email" />
              </label>
              <label>
                What's this about?
                <select name="topic">
                  <option value="question">A question</option>
                  <option value="work">Working together</option>
                  <option value="community">Community or speaking</option>
                  <option value="hello">Just saying hi</option>
                </select>
              </label>
              <label>
                Message
                <textarea name="message" rows="5" required minlength="2" maxlength="4000" />
              </label>
              <label class="check" data-include hidden>
                <input type="checkbox" name="include" /> Include my chat with the AI
              </label>
              <div class="hp" aria-hidden="true">
                <label>
                  Website
                  <input name="website" tabindex="-1" autocomplete="off" />
                </label>
              </div>
              <button class="btn btn-primary" type="submit">
                Send message
              </button>
              <p class="status" data-status role="status" />
            </form>
          </div>
        )
      }

      <div class={apiUrl ? 'direct' : 'actions'}>
        {apiUrl && <span>Or reach me directly:</span>}
        <a class="btn btn-ghost" href={`mailto:${profile.email}`}><Icon name="mail" /> {profile.email}</a>
        {
          profile.phone && (
            <a class="btn btn-ghost" href={`tel:${profile.phone}`}>
              <Icon name="phone" /> {phoneDisplay}
            </a>
          )
        }
        <a class="btn btn-ghost" href={profile.links.linkedin} target="_blank" rel="noopener"><Icon name="linkedin" /> LinkedIn</a>
        <a class="btn btn-ghost" href={profile.links.github} target="_blank" rel="noopener"><Icon name="github" /> GitHub</a>
      </div>
    </div>
  </div>
</section>

<script>
  import { post, errorText, renderText, ApiError, type Msg } from '../scripts/api';

  const root = document.querySelector<HTMLElement>('[data-api]');
  if (root) {
    const api = root.dataset.api!;
    const name = root.dataset.name!;
    const log = root.querySelector<HTMLElement>('[data-log]')!;
    const suggest = root.querySelector<HTMLElement>('[data-suggest]')!;
    const ask = root.querySelector<HTMLFormElement>('[data-ask]')!;
    const input = ask.querySelector('textarea')!;
    const handoff = root.querySelector<HTMLAnchorElement>('[data-handoff]')!;
    const form = root.querySelector<HTMLFormElement>('[data-contact]')!;
    const include = root.querySelector<HTMLElement>('[data-include]')!;
    const status = root.querySelector<HTMLElement>('[data-status]')!;
    const history: Msg[] = [];
    let busy = false;

    const add = (cls: string, text: string) => {
      const div = document.createElement('div');
      div.className = `msg ${cls}`;
      renderText(div, text);
      log.append(div);
      log.scrollTop = log.scrollHeight;
      return div;
    };

    async function send(text: string) {
      text = text.trim();
      if (!text || busy) return;
      if (history.filter((m) => m.role === 'user').length >= 8) {
        add('bot', `That's the limit for one chat. Send ${name} a message instead.`);
        return;
      }
      busy = true;
      suggest.hidden = true;
      add('me', text);
      history.push({ role: 'user', content: text });
      const wait = add('bot typing', '');
      try {
        const { reply } = await post<{ reply: string }>(api, '/api/chat', { messages: history, source: 'chat' });
        wait.remove();
        add('bot', reply);
        history.push({ role: 'assistant', content: reply });
        handoff.hidden = false;
        include.hidden = false;
      } catch (err) {
        wait.remove();
        history.pop();
        add('bot error', errorText(err));
      } finally {
        busy = false;
      }
    }

    suggest.querySelectorAll('button').forEach((b) => b.addEventListener('click', () => send(b.textContent || '')));

    ask.addEventListener('submit', (e) => {
      e.preventDefault();
      const text = input.value;
      input.value = '';
      input.style.height = '';
      send(text);
    });

    input.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' && !e.shiftKey) {
        e.preventDefault();
        ask.requestSubmit();
      }
    });

    input.addEventListener('input', () => {
      input.style.height = '';
      input.style.height = `${Math.min(input.scrollHeight, 140)}px`;
    });

    handoff.addEventListener('click', () => {
      include.querySelector('input')!.checked = true;
      setTimeout(() => form.querySelector<HTMLInputElement>('input[name="name"]')!.focus(), 300);
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!form.reportValidity()) return;
      const data = new FormData(form);
      const transcript = data.get('include')
        ? history.map((m) => `${m.role === 'user' ? 'Visitor' : 'Assistant'}: ${m.content}`).join('\n\n')
        : '';
      const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
      button.disabled = true;
      status.className = 'status';
      status.textContent = 'Sending…';
      try {
        await post(api, '/api/contact', {
          name: data.get('name'),
          email: data.get('email'),
          topic: data.get('topic'),
          message: data.get('message'),
          website: data.get('website'),
          transcript,
        });
        form.reset();
        status.className = 'status ok';
        status.textContent = `Thanks! Your message is on its way. ${name} will reply by email.`;
      } catch (err) {
        status.className = 'status bad';
        status.textContent =
          err instanceof ApiError && err.code === 'bad_request'
            ? 'Please check your email address and message, then try again.'
            : errorText(err).replace('the assistant', 'the server');
      } finally {
        button.disabled = false;
      }
    });
  }
</script>

<style>
  .panel {
    position: relative;
    overflow: hidden;
    padding: clamp(24px, 5vw, 56px);
    border-radius: 20px;
    border: 1px solid var(--border-strong);
    background:
      radial-gradient(40rem 20rem at 100% 0%, rgba(239, 78, 90, 0.18), transparent 70%),
      radial-gradient(30rem 20rem at 0% 100%, rgba(255, 143, 107, 0.1), transparent 70%),
      var(--surface);
  }
  h2 {
    margin-bottom: 16px !important;
  }
  .text {
    color: var(--text-2);
    max-width: 60ch;
    font-size: 1.05rem;
    margin-bottom: 28px;
  }
  .actions,
  .direct {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
  }
  .actions .btn {
    overflow-wrap: anywhere;
  }
  .direct {
    margin-top: 24px;
    color: var(--muted);
    font-size: 0.9rem;
  }
  .direct .btn {
    padding: 7px 12px;
    font-size: 0.85rem;
    font-weight: 500;
  }
  .duo {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    gap: 16px;
    align-items: stretch;
  }
  .duo .card {
    background: rgba(10, 12, 17, 0.55);
    border-color: var(--border-strong);
  }
  .chat {
    display: flex;
    flex-direction: column;
    padding: 18px;
    min-height: 460px;
  }
  .chat-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    margin-bottom: 12px;
  }
  .title {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-weight: 650;
    color: var(--accent-2);
  }
  .note {
    font-family: var(--mono);
    font-size: 0.72rem;
    color: var(--muted);
  }
  .log {
    flex: 1;
    min-height: 160px;
    max-height: 360px;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 4px 2px 8px;
    scrollbar-width: thin;
  }
  .log :global(.msg) {
    max-width: 88%;
    padding: 10px 14px;
    border-radius: 14px;
    font-size: 0.93rem;
    line-height: 1.55;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
  .log :global(.bot) {
    align-self: flex-start;
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-bottom-left-radius: 4px;
    color: var(--text-2);
  }
  .log :global(.me) {
    align-self: flex-end;
    background: var(--accent-soft);
    border: 1px solid rgba(239, 78, 90, 0.35);
    border-bottom-right-radius: 4px;
  }
  .log :global(.error) {
    border-color: rgba(231, 176, 79, 0.5);
    color: #f0cf8a;
  }
  .log :global(.typing)::after {
    content: '•••';
    letter-spacing: 3px;
    animation: blink 1.2s infinite;
  }
  @keyframes blink {
    50% {
      opacity: 0.3;
    }
  }
  .log :global(a) {
    color: var(--accent-2);
  }
  .suggest {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 8px 0 12px;
  }
  .suggest button {
    font: inherit;
    font-size: 0.82rem;
    text-align: left;
    color: var(--text-2);
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 6px 12px;
    cursor: pointer;
  }
  .suggest button:hover {
    color: var(--text);
    border-color: var(--accent);
  }
  .ask {
    display: flex;
    gap: 8px;
    align-items: flex-end;
    margin-top: 8px;
  }
  textarea,
  input,
  select {
    width: 100%;
    font: inherit;
    font-size: 0.95rem;
    color: var(--text);
    background: var(--bg);
    border: 1px solid var(--border-strong);
    border-radius: 10px;
    padding: 10px 12px;
  }
  textarea:focus,
  input:focus,
  select:focus {
    outline: none;
    border-color: var(--accent-2);
  }
  .ask textarea {
    resize: none;
    min-height: 42px;
  }
  .fine {
    margin: 10px 0 0;
    font-size: 0.78rem;
    color: var(--muted);
  }
  .fine a {
    display: inline-block;
    margin-top: 6px;
    color: var(--accent-2);
    font-weight: 600;
  }
  .form {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 20px;
  }
  .form h3 {
    font-size: 1.05rem;
  }
  .form label {
    display: grid;
    gap: 6px;
    font-size: 0.85rem;
    color: var(--text-2);
  }
  .form textarea {
    resize: vertical;
  }
  .form .check {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .check input {
    width: auto;
  }
  .hp {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  .form .btn {
    align-self: flex-start;
  }
  .form .btn:disabled {
    opacity: 0.6;
    cursor: wait;
  }
  .status {
    margin: 0;
    font-size: 0.88rem;
    min-height: 1.2em;
    color: var(--muted);
  }
  .status.ok {
    color: var(--ok);
  }
  .status.bad {
    color: #f0cf8a;
  }
  [hidden] {
    display: none !important;
  }
  @media (max-width: 860px) {
    .duo {
      grid-template-columns: minmax(0, 1fr);
    }
    .chat {
      min-height: 400px;
    }
  }
</style>
