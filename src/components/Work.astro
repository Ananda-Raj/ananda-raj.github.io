---
import Icon from './Icon.astro';
import { profile, projects } from '../lib/content';
import { getRepos } from '../lib/feeds';

const repos = (await getRepos()).slice(0, 6);
---

<section id="work" class="section">
  <div class="wrap">
    <p class="kicker">// work</p>
    <h2>Things I've built</h2>

    {
      projects.length > 0 && (
        <div class="projects">
          {projects.map((p) => (
            <article class="card project">
              <div class="top">
                <h3>{p.name}</h3>
                {p.status && <span class="chip status">{p.status}</span>}
              </div>
              <p>{p.summary}</p>
              <ul class="chips">
                {p.tech.map((t) => (
                  <li class="chip">{t}</li>
                ))}
              </ul>
              {(p.url || p.repo) && (
                <p class="links">
                  {p.url && <a href={p.url} target="_blank" rel="noopener">Visit <Icon name="arrow" size={14} /></a>}
                  {p.repo && <a href={p.repo} target="_blank" rel="noopener">Source <Icon name="arrow" size={14} /></a>}
                </p>
              )}
            </article>
          ))}
        </div>
      )
    }

    {
      repos.length > 0 && (
        <Fragment>
          <h3 class="sub">Open source on GitHub</h3>
          <div class="repos">
            {repos.map((r) => (
              <a class="card repo" href={r.url} target="_blank" rel="noopener">
                <span class="name">
                  <Icon name="github" size={16} /> {r.name}
                </span>
                {r.description && <span class="desc">{r.description}</span>}
                <span class="meta">
                  {r.language && <span>{r.language}</span>}
                  <span>Updated {new Date(r.updated).getFullYear()}</span>
                </span>
              </a>
            ))}
          </div>
          <a class="more" href={`${profile.links.github}?tab=repositories`} target="_blank" rel="noopener">
            All repositories <Icon name="arrow" size={14} />
          </a>
        </Fragment>
      )
    }
  </div>
</section>

<style>
  .projects {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 420px), 1fr));
    gap: 16px;
    margin-bottom: 48px;
  }
  .project {
    padding: 24px;
  }
  .top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    margin-bottom: 10px;
  }
  .project h3 {
    font-size: 1.25rem;
  }
  .project p {
    color: var(--text-2);
  }
  .status {
    color: var(--accent-2);
    border-color: rgba(255, 143, 107, 0.35);
  }
  .links {
    display: flex;
    gap: 18px;
    margin: 16px 0 0;
  }
  .links a {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-weight: 600;
    text-decoration: none;
  }
  .sub {
    font-size: 1.05rem;
    font-weight: 620;
    color: var(--text-2);
    margin-bottom: 16px;
  }
  .repos {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
    gap: 12px;
  }
  .repo {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 16px 18px;
  }
  .name {
    display: flex;
    align-items: center;
    gap: 8px;
    font-weight: 600;
    font-family: var(--mono);
    font-size: 0.92rem;
  }
  .desc {
    color: var(--text-2);
    font-size: 0.9rem;
  }
  .meta {
    display: flex;
    gap: 12px;
    margin-top: auto;
    font-family: var(--mono);
    font-size: 0.75rem;
    color: var(--muted);
  }
  .more {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    margin-top: 18px;
    font-weight: 600;
    text-decoration: none;
    color: var(--text-2);
  }
</style>
